# Configuração pública apenas. Segredos (passwords, chaves JWT, client secrets) vão para o Key Vault.
APP_ENV=development
LOG_LEVEL=INFO
# Origens separadas por vírgula. Vazio = nenhuma origem cross-origin permitida.
CORS_ORIGINS=http://localhost:3000

# OpenAI. A chave só pode estar no .env local de desenvolvimento; em produção vem do Key Vault.
OPENAI_API_KEY=
# Obrigatório: nome do modelo a usar (ver a lista de modelos da conta OpenAI).
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=1024

# Tempo máximo (segundos) de cada comando PowerShell executado pelo agente do CLI.
AGENT_COMMAND_TIMEOUT_SECONDS=120
